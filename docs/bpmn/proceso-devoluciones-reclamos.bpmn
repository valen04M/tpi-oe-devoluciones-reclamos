<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Part_comp" name="Comprador" processRef="Proc_comp" />
    <bpmn:participant id="Part_vend" name="Vendedor" processRef="Proc_vend" />
    <bpmn:participant id="Part_ml" name="Mercado Libre — Módulo de devoluciones y reclamos" processRef="Proc_ml" />
    <bpmn:participant id="Part_env" name="Mercado Envíos (servicio externo)" />
    <bpmn:participant id="Part_pag" name="Mercado Pago (servicio externo)" />
    <bpmn:messageFlow id="Msg_1" name="reclamo" sourceRef="C_t1" targetRef="S_ini" />
    <bpmn:messageFlow id="Msg_2" name="aviso" sourceRef="S_t2" targetRef="V_ini" />
    <bpmn:messageFlow id="Msg_3" name="respuesta" sourceRef="V_t1" targetRef="S_t2" />
    <bpmn:messageFlow id="Msg_4" name="resolución" sourceRef="S_t9" targetRef="C_rec" />
    <bpmn:messageFlow id="Msg_5" name="retiro del producto" sourceRef="S_dev" targetRef="Part_env" />
    <bpmn:messageFlow id="Msg_6" name="producto entregado" sourceRef="Part_env" targetRef="S_rcv" />
    <bpmn:messageFlow id="Msg_7" name="orden de reintegro" sourceRef="S_t8" targetRef="Part_pag" />
    <bpmn:messageFlow id="Msg_8" name="reintegro acreditado" sourceRef="Part_pag" targetRef="S_t9" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_comp" isExecutable="false">
    <bpmn:startEvent id="C_ini" name="Tiene un problema"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="C_t1" name="Registrar el reclamo o solicitar la devolución"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="C_rec" name="Recibe la resolución del caso"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="C_fin" name="Fin"><bpmn:incoming>Flow_3</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="C_ini" targetRef="C_t1" />
    <bpmn:sequenceFlow id="Flow_2" name="espera la resolución del caso" sourceRef="C_t1" targetRef="C_rec" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="C_rec" targetRef="C_fin" />
  </bpmn:process>
  <bpmn:process id="Proc_vend" isExecutable="false">
    <bpmn:startEvent id="V_ini" name="Notificación del reclamo"><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:startEvent>
    <bpmn:task id="V_t1" name="Revisar el reclamo y responder (aceptar o disputar)"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="V_fin" name="Respuesta enviada"><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="V_ini" targetRef="V_t1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="V_t1" targetRef="V_fin" />
  </bpmn:process>
  <bpmn:process id="Proc_ml" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_sis" name="Sistema (automatizado)">
        <bpmn:flowNodeRef>S_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_rech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_sin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_dev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_rcv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ana" name="Analista de reclamos">
        <bpmn:flowNodeRef>A_t1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_ini" name="Reclamo recibido"><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:startEvent>
    <bpmn:task id="S_t1" name="Recuperar datos de la compra, el pago y el envío"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="¿Reclamo válido?" gatewayDirection="Diverging"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="S_rech" name="Rechazar el reclamo y registrar el motivo"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:task>
    <bpmn:task id="S_t2" name="Notificar al vendedor y esperar respuesta (plazo de 48 h)"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="¿Acepta o vence el plazo?" gatewayDirection="Diverging"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="M1"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G3" name="¿A favor del comprador?" gatewayDirection="Diverging"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="S_sin" name="Resolver sin reintegro"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="G4" name="¿Hay que devolver el producto?" gatewayDirection="Diverging"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="S_dev" name="Generar la etiqueta de devolución"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="S_rcv" name="Producto recibido"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateCatchEvent>
    <bpmn:task id="S_t8" name="Solicitar el reintegro"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:task>
    <bpmn:task id="S_t9" name="Registrar indicadores, cerrar el caso y notificar al comprador"><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="S_fin" name="Caso cerrado"><bpmn:incoming>Flow_22</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="A_t1" name="Analizar la evidencia de ambas partes y resolver"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:task>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="S_ini" targetRef="S_t1" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="S_t1" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_8" name="Sí" sourceRef="G1" targetRef="S_t2" />
    <bpmn:sequenceFlow id="Flow_9" name="No" sourceRef="G1" targetRef="S_rech" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="S_t2" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_11" name="Sí" sourceRef="G2" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_12" name="No (el vendedor disputa)" sourceRef="G2" targetRef="A_t1" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="A_t1" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="M1" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_15" name="Sí" sourceRef="G3" targetRef="G4" />
    <bpmn:sequenceFlow id="Flow_16" name="No" sourceRef="G3" targetRef="S_sin" />
    <bpmn:sequenceFlow id="Flow_17" name="No" sourceRef="G4" targetRef="S_t8" />
    <bpmn:sequenceFlow id="Flow_18" name="Sí" sourceRef="G4" targetRef="S_dev" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="S_dev" targetRef="S_rcv" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="S_rcv" targetRef="S_t8" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="S_t8" targetRef="S_t9" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="S_t9" targetRef="S_fin" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="S_rech" targetRef="S_t9" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="S_sin" targetRef="S_t9" />
  </bpmn:process>
